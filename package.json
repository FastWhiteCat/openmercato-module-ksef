{
  "name": "@fastwhitecat/integration-ksef-direct",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*. js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/decorators": "^7.1.8",
    "@mikro-orm/migrations": "^7.1.8",
    "@open-mercato/core": ">=0.7.0 <0.8.0",
    "@open-mercato/queue": ">=0.7.0 <0.8.0",
    "@open-mercato/shared": ">=0.7.0 <0.8.0",
    "@open-mercato/ui": ">=0.7.0 <0.8.0",
    "@tanstack/react-table": "^9.0.0",
    "awilix": "^13.0.0",
    "lucide-react": "^1.16.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mikro-orm/decorators": "^7.1.8",
    "@mikro-orm/migrations": "^7.1.8",
    "@open-mercato/core": "0.7.0",
    "@open-mercato/queue": "0.7.0",
    "@open-mercato/shared": "0.7.0",
    "@open-mercato/ui": "0.7.0",
    "@tanstack/react-table": "^9.2.3",
    "@types/jest": "^30.0.0",
    "awilix": "^13.0.3",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "jest": "^30.2.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@open-mercato/queue": {
      "bullmq-otel": "^2.0.0"
    }
  },
  "open-mercato": {
    "displayName": "KSeF Direct Integration",
    "ejectable": true,
    "testedCoreRange": ">=0.7.0 <0.8.0",
    "upgradeNotesUrl": "https://github.com/FastWhiteCat/openmercato-module-ksef/releases"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
